# Translate the canonical patch description to the native runner's CSV format.
function(refare_write_startup_patches source output)
  file(READ "${source}" manifest)
  string(JSON count LENGTH "${manifest}" patches)
  if(count LESS 1)
    message(FATAL_ERROR "Startup patch manifest has no patches")
  endif()
  math(EXPR last "${count} - 1")
  set(rows)
  foreach(index RANGE 0 ${last})
    set(words)
    foreach(field address expected replacement)
      string(JSON word GET "${manifest}" patches ${index} ${field})
      string(REGEX REPLACE "^0[xX]" "" word "${word}")
      string(LENGTH "${word}" length)
      if(NOT length EQUAL 8 OR NOT word MATCHES "^[0-9a-fA-F]+$")
        message(FATAL_ERROR "Invalid startup patch word: ${word}")
      endif()
      list(APPEND words "${word}")
    endforeach()
    list(JOIN words "," row)
    list(APPEND rows "${row}")
  endforeach()
  # The native parser requires strictly increasing guest addresses.
  list(SORT rows)
  list(JOIN rows "\n" body)
  file(WRITE "${output}" "address,expected,replacement\n${body}\n")
endfunction()
if(CMAKE_SCRIPT_MODE_FILE)
  refare_write_startup_patches("${REFARE_STARTUP_JSON}" "${REFARE_STARTUP_CSV}")
endif()
