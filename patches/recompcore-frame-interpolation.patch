+// ReFare: render-only frame interpolation. See RefareFrameInterpolation.h.
+
+#include "VideoCommon/RefareFrameInterpolation.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <bit>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <mutex>
+#include <unordered_map>
+#include <vector>
+
+#include "Common/ChunkFile.h"
+#include "Common/Logging/Log.h"
+#include "Common/Swap.h"
+#include "Core/Config/GraphicsSettings.h"
+#include "Core/Config/MainSettings.h"
+#include "Core/System.h"
+#include "VideoCommon/AbstractGfx.h"
+#include "VideoCommon/AbstractTexture.h"
+#include "VideoCommon/BPFunctions.h"
+#include "VideoCommon/BPMemory.h"
+#include "VideoCommon/BPStructs.h"
+#include "VideoCommon/CPMemory.h"
+#include "VideoCommon/DataReader.h"
+#include "VideoCommon/FramebufferManager.h"
+#include "VideoCommon/GeometryShaderManager.h"
+#include "VideoCommon/OpcodeDecoding.h"
+#include "VideoCommon/PixelShaderManager.h"
+#include "VideoCommon/RefarePresentTimes.h"
+#include "VideoCommon/TextureConfig.h"
+#include "VideoCommon/VertexLoaderManager.h"
+#include "VideoCommon/VertexManagerBase.h"
+#include "VideoCommon/VertexShaderManager.h"
+#include "VideoCommon/VideoConfig.h"
+#include "VideoCommon/XFMemory.h"
+#include "VideoCommon/XFStateManager.h"
+
+namespace RefareFrameInterpolation
+{
+namespace
+{
+// A frame larger than this is not recorded (protects memory on odd titles).
+constexpr size_t kMaxStreamBytes = 64u << 20;
+
+struct XFLoad
+{
+  u32 offset;  // offset of the first data word inside the stream
+  u16 address;
+  u8 count;
+  u64 key = 0;  // 0 until the primitive using it is seen
+};
+
+struct Recording
+{
+  std::vector<u8> stream;
+  std::vector<XFLoad> loads;
+  std::vector<u32> pending;  // indices into `loads` awaiting their primitive
+  std::unordered_map<u64, u32> occurrences;
+  bool overflow = false;
+  // Whether anything this frame was drawn with a perspective projection.
+  // Frames without (menus, results screens) are pure 2D: shown as is, since
+  // in-between images only add cost and can smear sliding sprites.
+  bool has_3d = false;
+
+  void Clear()
+  {
+    stream.clear();
+    loads.clear();
+    pending.clear();
+    occurrences.clear();
+    overflow = false;
+    has_3d = false;
+  }
+};
+
+struct State
+{
+  bool enabled = false;
+  bool replaying = false;
+
+  // GPU state at the start of the frame being recorded.
+  bool have_start = false;
+  std::vector<u8> start_state;
+  bool start_cleared = false;
+  MathUtil::Rectangle<int> start_clear_rect;
+  u32 start_clear_ar = 0, start_clear_gb = 0, start_clear_z = 0;
+  bool start_color_update = false, start_alpha_update = false, start_z_update = false;
+  PixelFormat start_pixel_format{};
+
+  Recording current;
+
+  // Matrix values by match key: (offset, count) into a flat host-endian word
+  // buffer. Kept for the current and previous frame; buffers are reused so
+  // the per-frame path does not allocate in steady state.
+  struct KeyedWords
+  {
+    std::vector<u32> words;
+    std::unordered_map<u64, std::pair<u32, u32>> index;
+    void Clear()
+    {
+      words.clear();
+      index.clear();
+    }
+  };
+  KeyedWords current_values, previous;
+  bool have_previous = false;
+  struct Blend
+  {
+    const XFLoad* load;
+    u32 prev, cur;  // offsets into previous.words / current_values.words
+  };
+  std::vector<Blend> blends;
+  std::vector<u8> end_state;
+  std::vector<u8> replay_stream;
+
+  // Output pacing: display refreshes advanced per game frame accumulate in
+  // `phase`; each whole refresh crossed gets an image.
+  std::atomic<double> display_rate{0.0};
+  double phase = 0.0;
+  double paced_rate = 0.0;          // rate the Metal minimum duration is set for
+  double saved_min_duration = 0.0;  // ReFare's 60 Hz value, restored when off
+  bool speed_locked = false;        // emulation speed set to kLockedSpeed by us
+
+  std::unique_ptr<AbstractTexture> textures[kMaxInterpolated];
+  std::mutex frame_mutex;
+  bool frame_ready = false;
+  u32 frame_addr = 0;
+  FrameSet frame_set;
+
+  u64 stats_frames = 0;
+  u64 stats_loads = 0;
+  u64 stats_matched = 0;
+  u64 stats_blended = 0;
+  // Video-thread time spent in OnXFBCopy (since the last stats line).
+  double stats_work_ms = 0.0, stats_work_max_ms = 0.0;
+  u64 stats_work_frames = 0, stats_images = 0;
+  u64 stats_2d_frames = 0;
+  // On-glass intervals from the backend (Metal presentedTime), classified
+  // against the output refresh period.
+  u64 glass_head = 0;
+  double glass_last = 0.0;
+  u64 glass_on_time = 0, glass_long = 0, glass_short = 0, glass_dropped = 0;
+  double glass_worst_ms = 0.0;
+  // Presenter side (since the last stats line).
+  u64 stats_taken = 0, stats_shown = 0, stats_late = 0, stats_addr_mismatch = 0;
+  u64 stats_swaps = 0;
+  double stats_lateness_ms = 0.0, stats_max_lateness_ms = 0.0;
+  u32 stats_last_xfb = 0, stats_last_copy = 0;
+};
+
+State& S()
+{
+  static State state;
+  return state;
+}
+
+u64 Mix(u64 h, u64 v)
+{
+  h ^= v + 0x9e3779b97f4a7c15ull + (h << 6) + (h >> 2);
+  return h * 0xff51afd7ed558ccdull;
+}
+
+u64 HashBytes(const u8* data, u32 size)
+{
+  u64 h = 0xcbf29ce484222325ull;
+  for (u32 i = 0; i < size; ++i)
+    h = (h ^ data[i]) * 0x100000001b3ull;
+  return h;
+}
+
+void DoGPUState(PointerWrap& p)
+{
+  auto& system = Core::System::GetInstance();
+  p.Do(bpmem);
+  p.Do(g_main_cp_state);
+  p.Do(xfmem);
+  system.GetXFStateManager().DoState(p);
+  system.GetPixelShaderManager().DoState(p);
+  system.GetVertexShaderManager().DoState(p);
+  system.GetGeometryShaderManager().DoState(p);
+  g_vertex_manager->DoState(p);
+}
+
+void SaveGPUState(std::vector<u8>* buffer)
+{
+  u8* ptr = nullptr;
+  PointerWrap measure(&ptr, 0, PointerWrap::Mode::Measure);
+  DoGPUState(measure);
+  const size_t size = reinterpret_cast<size_t>(ptr);
+
+  buffer->resize(size);
+  ptr = buffer->data();
+  PointerWrap write(&ptr, size, PointerWrap::Mode::Write);
+  DoGPUState(write);
+}
+
+void LoadGPUState(std::vector<u8>& buffer)
+{
+  u8* ptr = buffer.data();
+  PointerWrap read(&ptr, buffer.size(), PointerWrap::Mode::Read);
+  DoGPUState(read);
+  CopyPreprocessCPStateFromMain();
+  // Same refresh as a savestate load (VideoState.cpp).
+  BPReload();
+  VertexLoaderManager::MarkAllDirty();
+}
+
+bool IsFloatWord(u32 address)
+{
+  // Position/texture matrices, normal matrices, post-transform matrices and
+  // the projection parameters. Lights mix colors (ints) with floats: skip.
+  return address < 0x100 || (address >= 0x400 && address < 0x460) ||
+         (address >= 0x500 && address < 0x600) || (address >= 0x1020 && address <= 0x1025);
+}
+
+// Decides whether two versions of a load are close enough to blend. Large
+// rotation changes are camera cuts or teleports: show the current frame's
+// value instead of a meaningless midpoint.
+bool ShouldBlend(u16 address, u8 count, const u32* prev, const u32* cur)
+{
+  if (address >= 0x1020 && address <= 0x1026)
+  {
+    // Projection: never blend across a perspective/orthographic switch, and
+    // treat a >20% scale change as a cut (FOV snap).
+    for (u32 i = 0; i < count; ++i)
+    {
+      const u32 a = address + i;
+      if (a == 0x1026 && prev[i] != cur[i])
+        return false;
+      if (a == 0x1020 || a == 0x1022)
+      {
+        const float p = std::bit_cast<float>(prev[i]);
+        const float c = std::bit_cast<float>(cur[i]);
+        if (std::abs(p - c) > 0.2f * std::max(std::abs(p), std::abs(c)))
+          return false;
+      }
+    }
+    return true;
+  }
+
+  // Matrices: rows of 4 floats (normal matrices rows of 3). Compare the
+  // linear part row by row, relative to the row's magnitude.
+  const u32 row = (address >= 0x400 && address < 0x460) ? 3 : 4;
+  for (u32 base = 0; base + row <= count; base += row)
+  {
+    float diff = 0.0f, norm = 0.0f;
+    for (u32 j = 0; j < 3; ++j)
+    {
+      const float p = std::bit_cast<float>(prev[base + j]);
+      const float c = std::bit_cast<float>(cur[base + j]);
+      if (!std::isfinite(p) || !std::isfinite(c))
+        return false;
+      diff = std::max(diff, std::abs(p - c));
+      norm = std::max(norm, std::max(std::abs(p), std::abs(c)));
+    }
+    if (diff > 0.35f * norm + 1e-6f)
+      return false;
+  }
+
+  // Full 3x4 matrices: also reject large jumps of the translation (camera-
+  // space position). Identical models drawn several times (traffic cars,
+  // pedestrians) can swap draw order between frames; blending two different
+  // instances would draw a ghost halfway between them.
+  if (row == 4)
+  {
+    for (u32 base = 0; base + 12 <= count; base += 12)
+    {
+      float d2 = 0.0f, p2 = 0.0f, c2 = 0.0f;
+      for (u32 r = 0; r < 3; ++r)
+      {
+        const float p = std::bit_cast<float>(prev[base + r * 4 + 3]);
+        const float c = std::bit_cast<float>(cur[base + r * 4 + 3]);
+        d2 += (p - c) * (p - c);
+        p2 += p * p;
+        c2 += c * c;
+      }
+      const float limit = 0.2f * std::sqrt(std::max(p2, c2));
+      if (d2 > limit * limit && d2 > 1e-8f)
+        return false;
+    }
+  }
+  return true;
+}
+
+AbstractTexture* EnsureTexture(int index, u32 width, u32 height, u32 layers,
+                               AbstractTextureFormat format)
+{
+  std::unique_ptr<AbstractTexture>& texture = S().textures[index];
+  if (texture)
+  {
+    const TextureConfig& c = texture->GetConfig();
+    if (c.width == width && c.height == height && c.layers == layers && c.format == format)
+      return texture.get();
+  }
+  texture = g_gfx->CreateTexture(TextureConfig(width, height, 1, layers, 1, format, 0,
+                                               AbstractTextureType::Texture_2DArray),
+                                 "ReFare interpolated frame");
+  return texture.get();
+}
+
+constexpr double kGameRate = 60000.0 / 1001.0;  // NTSC field rate at 100%
+constexpr double kMaxOutputRate = 180.0;
+// Emulation speed that makes the game produce exactly 60.000 frames/s. Display
+// refresh rates are whole multiples of that, so in-between images then line
+// up with refreshes indefinitely instead of drifting by one image every ~8 s
+// (59.94 vs 60). Audio pitch rises 0.1% (under 2 cents).
+constexpr float kLockedSpeed = 1.001f;
+
+// Frames per second the game is currently producing.
+double GameRate()
+{
+  const float speed = Config::Get(Config::MAIN_EMULATION_SPEED);
+  return speed > 0.0f ? kGameRate * speed : kGameRate;
+}
+
+// The rate to interpolate to: the configured one, or the display's.
+double TargetRate()
+{
+  State& s = S();
+  const int target = Config::Get(Config::GFX_REFARE_INTERPOLATION_TARGET);
+  const double display = s.display_rate.load(std::memory_order_relaxed);
+  double rate = target > 0 ? target : (display > 1.0 ? display : 120.0);
+  // More images than the display can show would just be thrown away.
+  if (display > 1.0)
+    rate = std::min(rate, display);
+  return std::clamp(rate, GameRate(), kMaxOutputRate);
+}
+
+// Metal with VSync keeps each drawable on screen for at least the configured
+// minimum duration, which ReFare sets to one 60 Hz frame on 60/120 Hz
+// displays. That would cap output at 60/s, so while interpolating it is set
+// to one output refresh and Metal itself spaces the images.
+void ApplyPacing(double rate)
+{
+  State& s = S();
+  if (rate == s.paced_rate)
+    return;
+  // Lock the game to 60.00 Hz while interpolating, unless the player chose
+  // another speed. Restore 100% when interpolation turns off.
+  const float speed = Config::Get(Config::MAIN_EMULATION_SPEED);
+  if (rate > 0.0 && !s.speed_locked && speed == 1.0f)
+  {
+    Config::SetCurrent(Config::MAIN_EMULATION_SPEED, kLockedSpeed);
+    s.speed_locked = true;
+  }
+  else if (rate == 0.0 && s.speed_locked)
+  {
+    if (speed == kLockedSpeed)
+      Config::SetCurrent(Config::MAIN_EMULATION_SPEED, 1.0f);
+    s.speed_locked = false;
+  }
+
+  if (s.paced_rate == 0.0)
+  {
+    // Turning on: remember ReFare's value (only touched when it is in use).
+    const double current = Config::Get(Config::GFX_MTL_MINIMUM_PRESENT_DURATION);
+    s.saved_min_duration = current > 0.0 ? current : 0.0;
+  }
+  s.paced_rate = rate;
+  if (rate > 0.0 && s.saved_min_duration > 0.0)
+  {
+    Config::SetCurrent(Config::GFX_MTL_MINIMUM_PRESENT_DURATION,
+                       std::max(0.0, 1.0 / rate - 0.0005));
+  }
+  else if (rate == 0.0 && s.saved_min_duration > 0.0)
+  {
+    Config::SetCurrent(Config::GFX_MTL_MINIMUM_PRESENT_DURATION, s.saved_min_duration);
+    s.saved_min_duration = 0.0;
+  }
+}
+
+// Per frame: Metal's minimum display time must match what this frame shows.
+// One refresh when in-between images are coming; ReFare's normal one-game-
+// frame value when only the real frame is shown (2D screens, warm-up),
+// otherwise those frames land 1 or 3 refreshes apart and pacing is uneven.
+void SetFrameMinDuration(bool interpolating, double rate)
+{
+  State& s = S();
+  if (s.saved_min_duration <= 0.0)
+    return;
+  const double want =
+      interpolating ? std::max(0.0, 1.0 / rate - 0.0005) : s.saved_min_duration;
+  if (Config::Get(Config::GFX_MTL_MINIMUM_PRESENT_DURATION) != want)
+    Config::SetCurrent(Config::GFX_MTL_MINIMUM_PRESENT_DURATION, want);
+}
+
+// Blend weights for this game frame's in-between images (0 < t < 1, toward
+// the current frame), and whether the real frame lands on a refresh of its
+// own. E.g. 120 Hz: {0.5}+real; 180 Hz: {1/3, 2/3}+real; 90 Hz alternates
+// {2/3} and {1/3}+real.
+std::vector<float> PlanSlots(double rate, bool* show_real)
+{
+  State& s = S();
+  const double k = rate / GameRate();  // display refreshes per game frame
+  // A refresh within this many refreshes of the real frame shows the real
+  // frame; keeps 120/180 Hz locked to exact fractions despite 59.94 vs 60.
+  constexpr double kSnap = 0.04;
+  std::vector<float> slots;
+  *show_real = false;
+  const double start = s.phase;
+  const double end = start + k;
+  for (double n = std::floor(start) + 1.0; n <= end + kSnap; n += 1.0)
+  {
+    if (n >= end - kSnap)
+    {
+      *show_real = true;
+      break;
+    }
+    if (slots.size() < static_cast<size_t>(kMaxInterpolated))
+      slots.push_back(static_cast<float>((n - start) / k));
+  }
+  s.phase = *show_real ? 0.0 : end - std::floor(end);
+  return slots;
+}
+}  // namespace
+
+bool IsEnabled()
+{
+  State& s = S();
+  const bool enabled = Config::Get(Config::GFX_REFARE_FRAME_INTERPOLATION);
+  if (enabled != s.enabled)
+  {
+    s.enabled = enabled;
+    Reset();
+    if (!enabled)
+      ApplyPacing(0.0);
+    INFO_LOG_FMT(VIDEO, "ReFare frame interpolation {}", enabled ? "on" : "off");
+  }
+  return enabled;
+}
+
+bool BackendPacesFrames()
+{
+  return S().enabled && g_backend_info.api_type == APIType::Metal &&
+         g_ActiveConfig.bVSyncActive &&
+         Config::Get(Config::GFX_MTL_MINIMUM_PRESENT_DURATION) > 0.0;
+}
+
+void SetDisplayRate(double hz)
+{
+  S().display_rate.store(hz, std::memory_order_relaxed);
+}
+
+double OutputRate()
+{
+  return Config::Get(Config::GFX_REFARE_FRAME_INTERPOLATION) ? TargetRate() : 0.0;
+}
+
+bool IsReplaying()
+{
+  return S().replaying;
+}
+
+void OnCommand(const u8* data, u32 size)
+{
+  State& s = S();
+  if (!s.enabled || s.replaying || !s.have_start)
+    return;
+  Recording& r = s.current;
+  if (r.overflow)
+    return;
+  if (r.stream.size() + size + 80 > kMaxStreamBytes)
+  {
+    r.overflow = true;
+    return;
+  }
+
+  const u8 opcode = data[0];
+  switch (static_cast<OpcodeDecoder::Opcode>(opcode))
+  {
+  case OpcodeDecoder::Opcode::GX_CMD_CALL_DL:
+    // Display-list contents were already recorded as they executed.
+    return;
+
+  case OpcodeDecoder::Opcode::GX_LOAD_BP_REG:
+  {
+    // Interrupt-raising writes would signal the CPU a second time.
+    const u8 reg = data[1];
+    if (reg == BPMEM_SETDRAWDONE || reg == BPMEM_PE_TOKEN_ID || reg == BPMEM_PE_TOKEN_INT_ID)
+      return;
+    if (reg == BPMEM_TRIGGER_EFB_COPY)
+    {
+      UPE_Copy copy;
+      copy.Hex = Common::swap24(&data[2]);
+      if (copy.copy_to_xfb)
+        return;
+    }
+    break;
+  }
+
+  case OpcodeDecoder::Opcode::GX_LOAD_XF_REG:
+  {
+    const u32 cmd2 = Common::swap32(&data[1]);
+    XFLoad load;
+    load.offset = static_cast<u32>(r.stream.size() + 5);
+    load.address = static_cast<u16>(cmd2 & 0xffff);
+    load.count = static_cast<u8>(((cmd2 >> 16) & 0xf) + 1);
+    r.pending.push_back(static_cast<u32>(r.loads.size()));
+    r.loads.push_back(load);
+    break;
+  }
+
+  case OpcodeDecoder::Opcode::GX_LOAD_INDX_A:
+  case OpcodeDecoder::Opcode::GX_LOAD_INDX_B:
+  case OpcodeDecoder::Opcode::GX_LOAD_INDX_C:
+  case OpcodeDecoder::Opcode::GX_LOAD_INDX_D:
+  {
+    // Indexed loads read guest RAM, which the CPU may already have
+    // overwritten when the replay runs. Record the values the load produced
+    // as an equivalent immediate XF load instead.
+    const u32 value = Common::swap32(&data[1]);
+    const u16 address = value & 0xFFF;
+    const u8 count = ((value >> 12) & 0xF) + 1;
+    if (address + count > XFMEM_REGISTERS_START)
+      return;
+    const u32 cmd2 = (u32(count - 1) << 16) | address;
+    const size_t at = r.stream.size();
+    r.stream.resize(at + 5 + count * 4u);
+    u8* out = &r.stream[at];
+    out[0] = static_cast<u8>(OpcodeDecoder::Opcode::GX_LOAD_XF_REG);
+    const u32 cmd2_be = Common::swap32(cmd2);
+    std::memcpy(out + 1, &cmd2_be, 4);
+    const u32* words = reinterpret_cast<const u32*>(&xfmem) + address;
+    for (u32 i = 0; i < count; ++i)
+    {
+      const u32 be = Common::swap32(words[i]);
+      std::memcpy(out + 5 + i * 4, &be, 4);
+    }
+    XFLoad load;
+    load.offset = static_cast<u32>(at + 5);
+    load.address = address;
+    load.count = count;
+    r.pending.push_back(static_cast<u32>(r.loads.size()));
+    r.loads.push_back(load);
+    return;
+  }
+
+  default:
+    if (opcode >= static_cast<u8>(OpcodeDecoder::Opcode::GX_PRIMITIVE_START) &&
+        opcode <= static_cast<u8>(OpcodeDecoder::Opcode::GX_PRIMITIVE_END))
+    {
+      if (xfmem.projection.type == ProjectionType::Perspective)
+        r.has_3d = true;
+      if (!r.pending.empty())
+      {
+        // Identify the draw by its header and leading vertex/index bytes.
+        const u64 prim = HashBytes(data, std::min<u32>(size, 64));
+        for (const u32 index : r.pending)
+        {
+          XFLoad& load = r.loads[index];
+          const u64 base = Mix(Mix(prim, load.address), load.count);
+          const u32 occurrence = r.occurrences[base]++;
+          load.key = Mix(base, occurrence) | 1;
+        }
+        r.pending.clear();
+      }
+    }
+    else if (opcode != static_cast<u8>(OpcodeDecoder::Opcode::GX_NOP) &&
+             opcode != static_cast<u8>(OpcodeDecoder::Opcode::GX_LOAD_CP_REG) &&
+             opcode != static_cast<u8>(OpcodeDecoder::Opcode::GX_CMD_INVL_VC) &&
+             opcode != static_cast<u8>(OpcodeDecoder::Opcode::GX_CMD_UNKNOWN_METRICS))
+    {
+      // Unknown opcodes are reported to the command processor; don't repeat.
+      return;
+    }
+    break;
+  }
+
+  r.stream.insert(r.stream.end(), data, data + size);
+}
+
+void OnFrameStart(bool cleared, const MathUtil::Rectangle<int>& clear_rect)
+{
+  State& s = S();
+  if (!s.enabled || s.replaying)
+    return;
+  g_vertex_manager->Flush();
+  s.current.Clear();
+  SaveGPUState(&s.start_state);
+  s.start_cleared = cleared;
+  s.start_clear_rect = clear_rect;
+  s.start_clear_ar = bpmem.clearcolorAR;
+  s.start_clear_gb = bpmem.clearcolorGB;
+  s.start_clear_z = bpmem.clearZValue;
+  s.start_color_update = bpmem.blendmode.color_update != 0;
+  s.start_alpha_update = bpmem.blendmode.alpha_update != 0;
+  s.start_z_update = bpmem.zmode.update_enable != 0;
+  s.start_pixel_format = bpmem.zcontrol.pixel_format;
+  s.have_start = true;
+}
+
+namespace
+{
+// Consume new on-glass timestamps and classify each interval: one refresh
+// (on time), 1.5+ refreshes (an image stayed up too long: a visible hitch),
+// or under half a refresh. Zero timestamps are images that never showed.
+void SampleGlass(double period)
+{
+  State& s = S();
+  auto& ring = RefarePresentTimes::Get();
+  const u64 head = ring.head.load(std::memory_order_acquire);
+  if (head - s.glass_head > ring.seconds.size())
+    s.glass_head = head - ring.seconds.size();
+  for (; s.glass_head < head; ++s.glass_head)
+  {
+    const double t = ring.seconds[s.glass_head % ring.seconds.size()].load(std::memory_order_relaxed);
+    if (t <= 0.0)
+    {
+      ++s.glass_dropped;
+      continue;
+    }
+    if (s.glass_last > 0.0 && period > 0.0)
+    {
+      const double dt = t - s.glass_last;
+      if (dt > 0.0 && dt < 1.0)
+      {
+        if (dt >= 1.5 * period)
+          ++s.glass_long;
+        else if (dt < 0.5 * period)
+          ++s.glass_short;
+        else
+          ++s.glass_on_time;
+        s.glass_worst_ms = std::max(s.glass_worst_ms, dt * 1000.0);
+      }
+    }
+    s.glass_last = t;
+  }
+}
+}  // namespace
+
+void OnXFBCopy(const MathUtil::Rectangle<int>& src_rect, u32 dest_addr)
+{
+  State& s = S();
+  if (!IsEnabled() || s.replaying)
+    return;
+
+  const auto work_start = std::chrono::steady_clock::now();
+  Recording& r = s.current;
+  const bool can_replay = s.have_start && !r.overflow && s.have_previous;
+
+  // Keyed matrix values of this frame, for the next frame's blend.
+  auto& values = s.current_values;
+  values.Clear();
+  values.words.reserve(r.loads.size() * 12);
+  for (const XFLoad& load : r.loads)
+  {
+    if (load.key == 0)
+      continue;
+    const u32 offset = static_cast<u32>(values.words.size());
+    for (u32 i = 0; i < load.count; ++i)
+      values.words.push_back(Common::swap32(&r.stream[load.offset + i * 4]));
+    values.index.emplace(load.key, std::make_pair(offset, u32(load.count)));
+  }
+
+  const double rate = TargetRate();
+  ApplyPacing(rate);
+  SampleGlass(1.0 / rate);
+  bool show_real = true;
+  const std::vector<float> slots =
+      can_replay && !r.stream.empty() && r.has_3d ? PlanSlots(rate, &show_real) : std::vector<float>{};
+  // 2D-only frame: no in-between images; restart the slot phase so the next
+  // 3D frame lines up with a refresh.
+  if (!r.has_3d)
+  {
+    s.phase = 0.0;
+    ++s.stats_2d_frames;
+  }
+  SetFrameMinDuration(!slots.empty(), rate);
+
+  if (!slots.empty())
+  {
+    // Matched loads worth blending.
+    auto& blends = s.blends;
+    blends.clear();
+    u64 matched = 0;
+    for (const XFLoad& load : r.loads)
+    {
+      if (load.key == 0)
+        continue;
+      const auto prev_it = s.previous.index.find(load.key);
+      if (prev_it == s.previous.index.end() || prev_it->second.second != load.count)
+        continue;
+      ++matched;
+      const u32 prev = prev_it->second.first;
+      const u32 cur = values.index.find(load.key)->second.first;
+      if (ShouldBlend(load.address, load.count, &s.previous.words[prev], &values.words[cur]))
+        blends.push_back({&load, prev, cur});
+    }
+    s.stats_loads += r.loads.size();
+    s.stats_matched += matched;
+    s.stats_blended += blends.size();
+
+    // Snapshot the end-of-frame state; each image rewinds to the start of the
+    // frame and renders it again with matrices blended to its weight.
+    g_vertex_manager->Flush();
+    SaveGPUState(&s.end_state);
+    std::vector<u8>& stream = s.replay_stream;
+    MathUtil::Rectangle<int> out_rect;
+    int rendered = 0;
+
+    for (const float t : slots)
+    {
+      stream = r.stream;
+      for (const State::Blend& blend : blends)
+      {
+        const XFLoad* load = blend.load;
+        const u32* prev = &s.previous.words[blend.prev];
+        const u32* cur = &values.words[blend.cur];
+        for (u32 i = 0; i < load->count; ++i)
+        {
+          if (!IsFloatWord(load->address + i))
+            continue;
+          const float p = std::bit_cast<float>(prev[i]);
+          const float c = std::bit_cast<float>(cur[i]);
+          const u32 v = Common::swap32(std::bit_cast<u32>(p + (c - p) * t));
+          std::memcpy(&stream[load->offset + i * 4], &v, 4);
+        }
+      }
+
+      LoadGPUState(s.start_state);
+      if (s.start_cleared)
+      {
+        BPFunctions::ClearScreen(g_framebuffer_manager.get(), s.start_clear_rect,
+                                 s.start_color_update, s.start_alpha_update,
+                                 s.start_z_update, s.start_pixel_format,
+                                 s.start_clear_ar, s.start_clear_gb, s.start_clear_z);
+        BPFunctions::SetScissorAndViewport(g_framebuffer_manager.get(), bpmem.scissorTL,
+                                           bpmem.scissorBR, bpmem.scissorOffset,
+                                           xfmem.viewport);
+      }
+
+      s.replaying = true;
+      OpcodeDecoder::RunFifo<false>(DataReader(stream.data(), stream.data() + stream.size()),
+                                    nullptr);
+      g_vertex_manager->Flush();
+      s.replaying = false;
+
+      // Keep a copy of the replayed EFB region for the presenter.
+      MathUtil::Rectangle<int> rect = g_framebuffer_manager->ConvertEFBRectangle(src_rect);
+      rect.ClampUL(0, 0, static_cast<int>(g_framebuffer_manager->GetEFBWidth()),
+                   static_cast<int>(g_framebuffer_manager->GetEFBHeight()));
+      AbstractTexture* efb = g_framebuffer_manager->ResolveEFBColorTexture(rect);
+      if (!efb || rect.GetWidth() <= 0 || rect.GetHeight() <= 0)
+        break;
+      std::lock_guard lock(s.frame_mutex);
+      AbstractTexture* texture =
+          EnsureTexture(rendered, rect.GetWidth(), rect.GetHeight(),
+                        g_framebuffer_manager->GetEFBLayers(), efb->GetConfig().format);
+      if (!texture)
+        break;
+      out_rect = {0, 0, rect.GetWidth(), rect.GetHeight()};
+      for (u32 layer = 0; layer < g_framebuffer_manager->GetEFBLayers(); ++layer)
+        texture->CopyRectangleFromTexture(efb, rect, layer, 0, out_rect, layer, 0);
+      texture->FinishedRendering();
+      ++rendered;
+    }
+
+    LoadGPUState(s.end_state);
+    s.stats_images += rendered;
+    {
+      const double ms = std::chrono::duration<double, std::milli>(
+                            std::chrono::steady_clock::now() - work_start)
+                            .count();
+      s.stats_work_ms += ms;
+      s.stats_work_max_ms = std::max(s.stats_work_max_ms, ms);
+      ++s.stats_work_frames;
+    }
+
+    if (rendered > 0)
+    {
+      std::lock_guard lock(s.frame_mutex);
+      FrameSet& set = s.frame_set;
+      set.count = rendered;
+      for (int i = 0; i < rendered; ++i)
+        set.textures[i] = s.textures[i].get();
+      set.rect = out_rect;
+      // If an image failed, fall back to showing the real frame.
+      set.show_real = show_real || rendered < static_cast<int>(slots.size());
+      set.period_s = 1.0 / rate;
+      s.frame_ready = true;
+      s.frame_addr = dest_addr;
+    }
+
+    // Set REFARE_INTERP_STATS=1 to print match statistics every ~10 s.
+    static const bool print_stats = std::getenv("REFARE_INTERP_STATS") != nullptr;
+    if ((++s.stats_frames % 600) == 0 && print_stats)
+    {
+      std::fprintf(stderr,
+                   "[refare] interpolation: %.0f Hz, %llu frames, %llu matrix loads, %.1f%% matched, "
+                   "%.1f%% blended, last stream %zu bytes\n"
+                   "[refare]   presenter: %llu swaps, %llu frames ready, %llu shown, %llu dropped "
+                   "late, %llu wrong XFB (vi %08x copy %08x), lateness avg %.1f max %.1f ms\n"
+                   "[refare]   video thread: %.2f images/frame, interpolation work avg %.2f max %.2f ms, "
+                   "%llu 2D-only frames shown as is\n"
+                   "[refare]   on glass: %llu on time, %llu held extra refresh, %llu early, %llu "
+                   "never shown, worst gap %.1f ms (game %.3f Hz)\n",
+                   rate, static_cast<unsigned long long>(s.stats_frames),
+                   static_cast<unsigned long long>(s.stats_loads),
+                   s.stats_loads ? 100.0 * s.stats_matched / s.stats_loads : 0.0,
+                   s.stats_loads ? 100.0 * s.stats_blended / s.stats_loads : 0.0,
+                   r.stream.size(), static_cast<unsigned long long>(s.stats_swaps),
+                   static_cast<unsigned long long>(s.stats_taken),
+                   static_cast<unsigned long long>(s.stats_shown),
+                   static_cast<unsigned long long>(s.stats_late),
+                   static_cast<unsigned long long>(s.stats_addr_mismatch), s.stats_last_xfb,
+                   s.stats_last_copy,
+                   s.stats_taken ? s.stats_lateness_ms / s.stats_taken : 0.0,
+                   s.stats_max_lateness_ms,
+                   s.stats_work_frames ? double(s.stats_images) / s.stats_work_frames : 0.0,
+                   s.stats_work_frames ? s.stats_work_ms / s.stats_work_frames : 0.0,
+                   s.stats_work_max_ms, static_cast<unsigned long long>(s.stats_2d_frames),
+                   static_cast<unsigned long long>(s.glass_on_time),
+                   static_cast<unsigned long long>(s.glass_long),
+                   static_cast<unsigned long long>(s.glass_short),
+                   static_cast<unsigned long long>(s.glass_dropped), s.glass_worst_ms,
+                   GameRate());
+      s.glass_on_time = s.glass_long = s.glass_short = s.glass_dropped = 0;
+      s.glass_worst_ms = 0.0;
+      s.stats_work_ms = s.stats_work_max_ms = 0.0;
+      s.stats_work_frames = s.stats_images = s.stats_2d_frames = 0;
+      s.stats_swaps = s.stats_taken = s.stats_shown = s.stats_late = s.stats_addr_mismatch = 0;
+      s.stats_lateness_ms = s.stats_max_lateness_ms = 0.0;
+    }
+  }
+
+  std::swap(s.previous, s.current_values);
+  s.have_previous = s.have_start && !r.overflow;
+}
+
+bool TakeFrames(u32 xfb_addr, FrameSet* out)
+{
+  State& s = S();
+  std::lock_guard lock(s.frame_mutex);
+  ++s.stats_swaps;
+  if (s.frame_ready && s.frame_addr != xfb_addr)
+  {
+    ++s.stats_addr_mismatch;
+    s.stats_last_xfb = xfb_addr;
+    s.stats_last_copy = s.frame_addr;
+  }
+  if (!s.frame_ready || s.frame_addr != xfb_addr || s.frame_set.count == 0)
+    return false;
+  s.frame_ready = false;
+  ++s.stats_taken;
+  *out = s.frame_set;
+  return true;
+}
+
+void NotePresent(bool shown, double lateness_ms)
+{
+  State& s = S();
+  std::lock_guard lock(s.frame_mutex);
+  if (shown)
+    ++s.stats_shown;
+  else
+    ++s.stats_late;
+  s.stats_lateness_ms += lateness_ms;
+  s.stats_max_lateness_ms = std::max(s.stats_max_lateness_ms, lateness_ms);
+}
+
+void Reset()
+{
+  State& s = S();
+  s.current.Clear();
+  s.have_start = false;
+  s.have_previous = false;
+  s.previous.Clear();
+  s.phase = 0.0;
+  std::lock_guard lock(s.frame_mutex);
+  s.frame_ready = false;
+}
+}  // namespace RefareFrameInterpolation
