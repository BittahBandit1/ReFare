diff --git a/Source/Core/DolphinNoGUI/PlatformMacos.mm b/Source/Core/DolphinNoGUI/PlatformMacos.mm
index 98959d8..0a9ae3e 100644
--- a/Source/Core/DolphinNoGUI/PlatformMacos.mm
