diff --git a/Source/Core/VideoCommon/RefarePresentTimes.h b/Source/Core/VideoCommon/RefarePresentTimes.h
new file mode 100644
index 0000000..0050a4b
--- /dev/null
+++ b/Source/Core/VideoCommon/RefarePresentTimes.h
@@ -0,0 +1,31 @@
+// ReFare diagnostic: on-glass present times reported by the video backend
+// (Metal: MTLDrawable.presentedTime, in host-clock seconds). Lock-free ring
+// written by the presentation callback, read by the pacing recorder.
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <cstdint>
+
+namespace RefarePresentTimes
+{
+struct Ring
+{
+  std::array<std::atomic<double>, 512> seconds{};
+  std::atomic<uint64_t> head{0};
+};
+
+inline Ring& Get()
+{
+  static Ring ring;
+  return ring;
+}
+
+inline void Push(double presented_seconds)
+{
+  Ring& ring = Get();
+  const uint64_t index = ring.head.load(std::memory_order_relaxed);
+  ring.seconds[index % ring.seconds.size()].store(presented_seconds, std::memory_order_relaxed);
+  ring.head.store(index + 1, std::memory_order_release);
+}
+}  // namespace RefarePresentTimes
