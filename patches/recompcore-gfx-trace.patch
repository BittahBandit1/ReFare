diff --git a/Source/Core/VideoCommon/RefareGfxTrace.h b/Source/Core/VideoCommon/RefareGfxTrace.h
new file mode 100644
index 0000000..f8b45cb
--- /dev/null
+++ b/Source/Core/VideoCommon/RefareGfxTrace.h
@@ -0,0 +1,88 @@
+// ReFare diagnostic: one-shot GPU command trace for game-specific render fixes.
+// Enabled only when REFARE_GFX_TRACE_DIR is set. Creating <dir>/trace-request
+// records the next few frames into <dir>/gfx-trace-N.txt. Zero cost otherwise
+// beyond a getenv check and one file-existence check per XFB copy.
+#pragma once
+
+#include <cstdio>
+#include <cstdlib>
+#include <filesystem>
+#include <string>
+
+namespace RefareGfxTrace
+{
+struct State
+{
+  std::FILE* file = nullptr;
+  int frames_left = 0;
+  int index = 0;
+  bool checked = false;
+  std::string dir;
+  unsigned long long events = 0;
+};
+
+inline State& Get()
+{
+  static State state;
+  return state;
+}
+
+inline const std::string& Dir()
+{
+  State& s = Get();
+  if (!s.checked)
+  {
+    s.checked = true;
+    if (const char* dir = std::getenv("REFARE_GFX_TRACE_DIR"))
+      s.dir = dir;
+  }
+  return s.dir;
+}
+
+inline std::FILE* Active()
+{
+  return Get().file;
+}
+
+// Call after each XFB copy. Ends the current traced frame, or begins tracing
+// when a request file is present.
+inline void OnFrameBoundary()
+{
+  State& s = Get();
+  const std::string& dir = Dir();
+  if (dir.empty())
+    return;
+  if (s.file)
+  {
+    std::fprintf(s.file, "=== XFB copy: end of frame (events=%llu) ===\n", s.events);
+    if (--s.frames_left <= 0)
+    {
+      std::fclose(s.file);
+      s.file = nullptr;
+    }
+    return;
+  }
+  namespace fs = std::filesystem;
+  std::error_code ec;
+  const fs::path request = fs::path(dir) / "trace-request";
+  if (!fs::exists(request, ec))
+    return;
+  int frames = 3;
+  if (std::FILE* req = std::fopen(request.string().c_str(), "r"))
+  {
+    int n = 0;
+    if (std::fscanf(req, "%d", &n) == 1 && n > 0 && n < 120)
+      frames = n;
+    std::fclose(req);
+  }
+  fs::remove(request, ec);
+  while (fs::exists(fs::path(dir) / ("gfx-trace-" + std::to_string(s.index) + ".txt"), ec))
+    ++s.index;
+  const fs::path out = fs::path(dir) / ("gfx-trace-" + std::to_string(s.index++) + ".txt");
+  s.file = std::fopen(out.string().c_str(), "w");
+  s.frames_left = frames;
+  s.events = 0;
+  if (s.file)
+    std::fprintf(s.file, "=== trace start: %d frames ===\n", frames);
+}
+}  // namespace RefareGfxTrace
