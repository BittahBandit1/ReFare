diff --git a/Source/Core/AudioCommon/IOSSoundStream.mm b/Source/Core/AudioCommon/IOSSoundStream.mm
new file mode 100644
--- /dev/null
+++ b/Source/Core/AudioCommon/IOSSoundStream.mm
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "AudioCommon/SoundStream.h"
+#include <AudioToolbox/AudioToolbox.h>
+#include <algorithm>
+#include <atomic>
+#include <cstring>
+
+namespace AudioCommon {
+namespace {
+class IOSSoundStream final : public SoundStream {
+  AudioUnit unit = nullptr;
+  std::atomic<float> volume{1.0f};
+  static OSStatus Render(void* context, AudioUnitRenderActionFlags*,
+                         const AudioTimeStamp*, UInt32, UInt32 frames,
+                         AudioBufferList* output) {
+    auto& self = *static_cast<IOSSoundStream*>(context);
+    if (!output || output->mNumberBuffers != 1 || !output->mBuffers[0].mData ||
+        output->mBuffers[0].mDataByteSize < frames * 4) return kAudio_ParamError;
+    auto* samples = static_cast<short*>(output->mBuffers[0].mData);
+    self.m_mixer->Mix(samples, frames);
+    const float gain = self.volume.load(std::memory_order_relaxed);
+    for (UInt32 i = 0; i < frames * 2; ++i) samples[i] = static_cast<short>(samples[i] * gain);
+    return noErr;
+  }
+public:
+  ~IOSSoundStream() override {
+    if (unit) { AudioOutputUnitStop(unit); AudioUnitUninitialize(unit); AudioComponentInstanceDispose(unit); }
+  }
+  bool Init() override {
+    AudioComponentDescription description{};
+    description.componentType = kAudioUnitType_Output;
+    description.componentSubType = kAudioUnitSubType_RemoteIO;
+    description.componentManufacturer = kAudioUnitManufacturer_Apple;
+    auto component = AudioComponentFindNext(nullptr, &description);
+    if (!component || AudioComponentInstanceNew(component, &unit) != noErr) return false;
+    AudioStreamBasicDescription format{};
+    format.mSampleRate = 48000;
+    format.mFormatID = kAudioFormatLinearPCM;
+    format.mFormatFlags = kAudioFormatFlagIsSignedInteger | kAudioFormatFlagIsPacked;
+    format.mFramesPerPacket = 1;
+    format.mChannelsPerFrame = 2;
+    format.mBitsPerChannel = 16;
+    format.mBytesPerPacket = format.mBytesPerFrame = 4;
+    if (AudioUnitSetProperty(unit, kAudioUnitProperty_StreamFormat, kAudioUnitScope_Input,
+                             0, &format, sizeof(format)) != noErr) return false;
+    AURenderCallbackStruct callback{Render, this};
+    if (AudioUnitSetProperty(unit, kAudioUnitProperty_SetRenderCallback, kAudioUnitScope_Input,
+                             0, &callback, sizeof(callback)) != noErr) return false;
+    return AudioUnitInitialize(unit) == noErr;
+  }
+  bool SetRunning(bool running) override {
+    return unit && (running ? AudioOutputUnitStart(unit) : AudioOutputUnitStop(unit)) == noErr;
+  }
+  void SetVolume(int value) override { volume.store(std::clamp(value, 0, 100) / 100.0f); }
+};
+}
+std::unique_ptr<SoundStream> CreateIOSSoundStream() { return std::make_unique<IOSSoundStream>(); }
+}
