diff --git a/Source/Core/VideoBackends/Metal/MTLFXScaler.h b/Source/Core/VideoBackends/Metal/MTLFXScaler.h
new file mode 100644
--- /dev/null
+++ b/Source/Core/VideoBackends/Metal/MTLFXScaler.h
@@ -0,0 +1,22 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include <Metal/Metal.h>
+#include <memory>
+namespace Metal {
+// Render-thread-only owner. Encodes crop + spatial upscale on the caller's
+// command buffer, preserving ordering with game drawing and presentation.
+class FXSpatialScaler {
+public:
+  FXSpatialScaler();
+  ~FXSpatialScaler();
+  static bool Supported(id<MTLDevice> device);
+  id<MTLTexture> Encode(id<MTLDevice> device, id<MTLCommandBuffer> command,
+                       id<MTLTexture> source, unsigned x, unsigned y,
+                       unsigned width, unsigned height, unsigned output_width,
+                       unsigned output_height);
+  void Reset();
+private:
+  struct Impl;
+  std::unique_ptr<Impl> m_impl;
+};
+}
diff --git a/Source/Core/VideoBackends/Metal/MTLFXScaler.mm b/Source/Core/VideoBackends/Metal/MTLFXScaler.mm
new file mode 100644
--- /dev/null
+++ b/Source/Core/VideoBackends/Metal/MTLFXScaler.mm
@@ -0,0 +1,78 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "MTLFXScaler.h"
+#include "MRCHelpers.h"
+#import <MetalFX/MetalFX.h>
+namespace Metal {
+struct FXSpatialScaler::Impl {
+  MRCOwned<id> scaler;
+  MRCOwned<id<MTLTexture>> input, output, array_view;
+  id<MTLDevice> device = nil;
+  unsigned width = 0, height = 0, out_width = 0, out_height = 0;
+  MTLPixelFormat format = MTLPixelFormatInvalid;
+};
+FXSpatialScaler::FXSpatialScaler() : m_impl(std::make_unique<Impl>()) {}
+FXSpatialScaler::~FXSpatialScaler() = default;
+void FXSpatialScaler::Reset() { m_impl = std::make_unique<Impl>(); }
+bool FXSpatialScaler::Supported(id<MTLDevice> device) {
+  if (@available(iOS 16.0, macOS 13.0, *))
+    return device && [MTLFXSpatialScalerDescriptor supportsDevice:device];
+  return false;
+}
+id<MTLTexture> FXSpatialScaler::Encode(id<MTLDevice> device, id<MTLCommandBuffer> command,
+                                     id<MTLTexture> source, unsigned x, unsigned y,
+                                     unsigned width, unsigned height,
+                                     unsigned output_width, unsigned output_height) {
+  if (!Supported(device) || !command || !source || !width || !height ||
+      !output_width || !output_height || x > source.width || y > source.height ||
+      width > source.width-x || height > source.height-y || source.sampleCount != 1 ||
+      output_width < width || output_height < height) return nil;
+  if (@available(iOS 16.0, macOS 13.0, *)) {
+    auto& state = *m_impl;
+    const auto format = source.pixelFormat;
+    if (!state.scaler || state.device != device || state.width != width || state.height != height ||
+        state.out_width != output_width || state.out_height != output_height || state.format != format) {
+      Reset();
+      auto descriptor = MRCTransfer([MTLFXSpatialScalerDescriptor new]);
+      descriptor.Get().inputWidth = width; descriptor.Get().inputHeight = height;
+      descriptor.Get().outputWidth = output_width; descriptor.Get().outputHeight = output_height;
+      descriptor.Get().colorTextureFormat = format; descriptor.Get().outputTextureFormat = format;
+      descriptor.Get().colorProcessingMode = MTLFXSpatialScalerColorProcessingModePerceptual;
+      auto scaler = MRCTransfer([descriptor newSpatialScalerWithDevice:device]);
+      if (!scaler) return nil;
+      auto texture = MRCTransfer([MTLTextureDescriptor new]);
+      texture.Get().textureType = MTLTextureType2D;
+      texture.Get().pixelFormat = format;
+      texture.Get().storageMode = MTLStorageModePrivate;
+      texture.Get().width = width; texture.Get().height = height;
+      texture.Get().usage = scaler.Get().colorTextureUsage | MTLTextureUsageShaderRead;
+      auto input = MRCTransfer([device newTextureWithDescriptor:texture]);
+      texture.Get().width = output_width; texture.Get().height = output_height;
+      texture.Get().usage = scaler.Get().outputTextureUsage | MTLTextureUsageShaderRead | MTLTextureUsagePixelFormatView;
+      auto output = MRCTransfer([device newTextureWithDescriptor:texture]);
+      if (!input || !output) return nil;
+      auto view = MRCTransfer([output newTextureViewWithPixelFormat:format
+          textureType:MTLTextureType2DArray levels:NSMakeRange(0,1) slices:NSMakeRange(0,1)]);
+      if (!view) return nil;
+      input.Get().label = @"ReFare MetalFX cropped input";
+      output.Get().label = @"ReFare MetalFX spatial output";
+      m_impl->scaler = MRCRetain((id)scaler.Get());
+      m_impl->input = std::move(input); m_impl->output = std::move(output);
+      m_impl->array_view = std::move(view); m_impl->device = device;
+      m_impl->width = width; m_impl->height = height;
+      m_impl->out_width = output_width; m_impl->out_height = output_height; m_impl->format = format;
+    }
+    auto blit = [command blitCommandEncoder];
+    if (!blit) return nil;
+    [blit copyFromTexture:source sourceSlice:0 sourceLevel:0 sourceOrigin:MTLOriginMake(x,y,0)
+               sourceSize:MTLSizeMake(width,height,1) toTexture:m_impl->input
+         destinationSlice:0 destinationLevel:0 destinationOrigin:MTLOriginMake(0,0,0)];
+    [blit endEncoding];
+    id<MTLFXSpatialScaler> scaler = m_impl->scaler.Get();
+    scaler.colorTexture = m_impl->input; scaler.outputTexture = m_impl->output;
+    scaler.inputContentWidth = width; scaler.inputContentHeight = height;
+    [scaler encodeToCommandBuffer:command];
+    return m_impl->array_view;
+  }
+  return nil;
+}
+}
