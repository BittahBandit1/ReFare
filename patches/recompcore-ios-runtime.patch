diff --git a/Source/Core/VideoBackends/Metal/MTLSpatialUpscaler.mm b/Source/Core/VideoBackends/Metal/MTLSpatialUpscaler.mm
new file mode 100644
--- /dev/null
+++ b/Source/Core/VideoBackends/Metal/MTLSpatialUpscaler.mm
@@ -0,0 +1,48 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "VideoCommon/RefareMetalFX.h"
+#include "VideoBackends/Metal/MTLFXScaler.h"
+#include "VideoBackends/Metal/MTLTexture.h"
+#include "VideoBackends/Metal/MTLObjectCache.h"
+#include "VideoBackends/Metal/MTLStateTracker.h"
+#include "Common/Config/Config.h"
+#include "Core/Config/GraphicsSettings.h"
+#include <atomic>
+#include <cstdio>
+namespace RefareMetalFX {
+namespace {
+std::atomic<Support> support{Support::NotReady};
+std::unique_ptr<Metal::FXSpatialScaler> scaler;
+std::unique_ptr<Metal::Texture> result;
+}
+Support GetSupport() { return support.load(); }
+void Initialize() {
+  result.reset(); scaler.reset();
+  support = Metal::FXSpatialScaler::Supported(Metal::g_device) ? Support::Available : Support::Unavailable;
+  std::fprintf(stderr,"[MetalFX] spatial upscaling %s\n",GetSupport() == Support::Available ? "available" : "unavailable on this OS/GPU");
+}
+void Shutdown() { result.reset(); scaler.reset(); support = Support::NotReady; }
+const AbstractTexture* Upscale(const AbstractTexture* source, const MathUtil::Rectangle<int>& region,
+                              unsigned width, unsigned height) {
+  if (!Config::Get(Config::GFX_METALFX_SPATIAL)) { result.reset(); scaler.reset(); return nullptr; }
+  if (GetSupport() != Support::Available || !source || source->GetLayers() != 1 ||
+      region.left < 0 || region.top < 0 || region.GetWidth() <= 0 || region.GetHeight() <= 0 ||
+      width < static_cast<unsigned>(region.GetWidth()) || height < static_cast<unsigned>(region.GetHeight()) ||
+      (width == static_cast<unsigned>(region.GetWidth()) && height == static_cast<unsigned>(region.GetHeight()))) return nullptr;
+  const auto* texture = static_cast<const Metal::Texture*>(source);
+  if (!scaler) scaler = std::make_unique<Metal::FXSpatialScaler>();
+  Metal::g_state_tracker->EndRenderPass();
+  auto output = scaler->Encode(Metal::g_device, Metal::g_state_tracker->GetRenderCmdBuf(), texture->GetMTLTexture(),
+                              region.left, region.top, region.GetWidth(), region.GetHeight(), width, height);
+  if (!output) {
+    support = Support::Failed;
+    result.reset(); scaler.reset();
+    std::fprintf(stderr,"[MetalFX] scaler initialization failed; using normal presentation\n");
+    return nullptr;
+  }
+  if (!result || result->GetMTLTexture() != output) {
+    TextureConfig config(width,height,1,1,1,source->GetFormat(),0,AbstractTextureType::Texture_2DArray);
+    result = std::make_unique<Metal::Texture>(MRCRetain(output),config);
+  }
+  return result.get();
+}
+}
