@@ -311,12 +311,33 @@ void PlatformMacOS::ProcessEvents()
                                            inMode:NSDefaultRunLoopMode
                                           dequeue:YES];
 
-    [NSApp sendEvent:event];
+    // Game input reads the keyboard state directly. Plain key events have no
+    // responder in the render view, so AppKit would beep on every key press;
+    // only forward keys that carry Command, for menu shortcuts such as Cmd-Q.
+    const bool plain_key = event &&
+                           (event.type == NSEventTypeKeyDown || event.type == NSEventTypeKeyUp) &&
+                           !(event.modifierFlags & NSEventModifierFlagCommand);
+    // Cmd+Return (or Cmd+keypad Enter) toggles fullscreen, as in most Mac games.
+    const bool fullscreen_key = event && event.type == NSEventTypeKeyDown &&
+                                (event.modifierFlags & NSEventModifierFlagCommand) &&
+                                (event.keyCode == 36 || event.keyCode == 76);
+    if (fullscreen_key)
+    {
+      if (!event.isARepeat)
+        [m_window toggleFullScreen:nil];
+    }
+    else if (!plain_key)
+    {
+      [NSApp sendEvent:event];
+    }
 
     // Need to update if m_window becomes fullscreen
     m_window_fullscreen = [m_window styleMask] & NSWindowStyleMaskFullScreen;
 
