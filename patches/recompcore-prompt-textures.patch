@@ -0,0 +1,38 @@
+// ReFare: swap texture-baked button prompts for keyboard variants.
+//
+// The frontend registers (original texels, replacement image) pairs built
+// from the game's own files. While keyboard mode is on, a texture whose raw
+// data matches an original is created from the replacement instead; switching
+// modes evicts the matching cache entries so the change shows immediately.
+#pragma once
+
+#include <memory>
+#include <vector>
+
+#include "Common/CommonTypes.h"
+
+class TextureInfo;
+namespace VideoCommon
+{
+class CustomTextureData;
+}
+
+namespace RefarePromptTextures
+{
+// `texels`: raw GX data as the game loads it. `rgba`: linear RGBA8, same size.
+// Call before rendering starts.
+void Register(std::vector<u8> texels, u32 width, u32 height, u32 gx_format, std::vector<u8> rgba);
+
+// Any thread. Takes effect on the next texture lookup.
+void SetKeyboard(bool keyboard);
+
+// Video thread (texture cache): the replacement for this texture, if any.
+std::shared_ptr<VideoCommon::CustomTextureData> Find(const TextureInfo& texture_info);
+
+// Video thread: true once after each mode change, when matching cache entries
+// should be evicted.
+bool TakeModeChange();
+
+// Whether a texture of this size/format could be a registered prompt.
+bool MayMatch(u32 width, u32 height, u32 gx_format);
+}  // namespace RefarePromptTextures
