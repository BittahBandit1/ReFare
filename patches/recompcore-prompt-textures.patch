diff --git a/Source/Core/VideoCommon/RefarePromptTextures.cpp b/Source/Core/VideoCommon/RefarePromptTextures.cpp
new file mode 100644
index 0000000..0dda199
--- /dev/null
+++ b/Source/Core/VideoCommon/RefarePromptTextures.cpp
@@ -0,0 +1,93 @@
+// ReFare: swap texture-baked button prompts for keyboard variants.
+
+#include "VideoCommon/RefarePromptTextures.h"
+
+#include <atomic>
+#include <cstdio>
+#include <cstring>
+#include <mutex>
+
+#include "VideoCommon/Assets/CustomTextureData.h"
+#include "VideoCommon/TextureInfo.h"
+
+namespace RefarePromptTextures
+{
+namespace
+{
+struct Entry
+{
+  std::vector<u8> texels;
+  u32 width, height, gx_format;
+  std::shared_ptr<VideoCommon::CustomTextureData> keyboard;
+};
+
+std::mutex s_mutex;
+std::vector<Entry> s_entries;
+std::atomic<bool> s_keyboard{false};
+std::atomic<bool> s_changed{false};
+}  // namespace
+
+void Register(std::vector<u8> texels, u32 width, u32 height, u32 gx_format, std::vector<u8> rgba)
+{
+  if (rgba.size() != size_t(width) * height * 4)
+    return;
+  auto data = std::make_shared<VideoCommon::CustomTextureData>();
+  auto& level = data->m_slices.emplace_back().m_levels.emplace_back();
+  level.width = width;
+  level.height = height;
+  level.row_length = width;
+  level.format = AbstractTextureFormat::RGBA8;
+  level.data = Common::UniqueBuffer<u8>(rgba.size());
+  std::memcpy(level.data.data(), rgba.data(), rgba.size());
+  std::lock_guard lock(s_mutex);
+  s_entries.push_back({std::move(texels), width, height, gx_format, std::move(data)});
+}
+
+void SetKeyboard(bool keyboard)
+{
+  if (s_keyboard.exchange(keyboard) != keyboard)
+    s_changed.store(true);
+}
+
+bool TakeModeChange()
+{
+  return s_changed.load(std::memory_order_relaxed) && s_changed.exchange(false);
+}
+
+bool MayMatch(u32 width, u32 height, u32 gx_format)
+{
+  std::lock_guard lock(s_mutex);
+  for (const Entry& e : s_entries)
+  {
+    if (e.width == width && e.height == height && e.gx_format == gx_format)
+      return true;
+  }
+  return false;
+}
+
+std::shared_ptr<VideoCommon::CustomTextureData> Find(const TextureInfo& texture_info)
+{
+  if (!s_keyboard.load(std::memory_order_relaxed))
+    return nullptr;
+  const u32 format = static_cast<u32>(texture_info.GetTextureFormat());
+  std::lock_guard lock(s_mutex);
+  for (const Entry& e : s_entries)
+  {
+    if (e.width != texture_info.GetRawWidth() || e.height != texture_info.GetRawHeight() ||
+        e.gx_format != format || texture_info.GetTextureSize() < e.texels.size() ||
+        !texture_info.GetData())
+      continue;
+    if (std::memcmp(texture_info.GetData(), e.texels.data(), e.texels.size()) == 0)
+    {
+      static bool s_logged = false;
+      if (!s_logged)
+      {
+        s_logged = true;
+        std::fprintf(stderr, "[refare] button prompts: keyboard prompt texture in use\n");
+      }
+      return e.keyboard;
+    }
+  }
+  return nullptr;
+}
+}  // namespace RefarePromptTextures
diff --git a/Source/Core/VideoCommon/RefarePromptTextures.h b/Source/Core/VideoCommon/RefarePromptTextures.h
new file mode 100644
