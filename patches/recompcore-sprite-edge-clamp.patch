+bool VertexManagerBase::IsUnitTexcoordSprite() const
+{
+  if (xfmem.projection.type != ProjectionType::Orthographic)
+    return false;
+  const u32 num_texgens = xfmem.numTexGen.numTexGens;
+  const NativeVertexFormat* format = VertexLoaderManager::GetCurrentVertexFormat();
+  const u32 num_verts = m_index_generator.GetNumVerts();
+  if (num_texgens == 0 || !format || num_verts == 0 || num_verts > 1024)
+    return false;
+  const PortableVertexDeclaration& decl = format->GetVertexDeclaration();
+  const u32 matrix_index[8] = {
+      xfmem.MatrixIndexA.Tex0MtxIdx, xfmem.MatrixIndexA.Tex1MtxIdx,
+      xfmem.MatrixIndexA.Tex2MtxIdx, xfmem.MatrixIndexA.Tex3MtxIdx,
+      xfmem.MatrixIndexB.Tex4MtxIdx, xfmem.MatrixIndexB.Tex5MtxIdx,
+      xfmem.MatrixIndexB.Tex6MtxIdx, xfmem.MatrixIndexB.Tex7MtxIdx};
+  std::array<int, 8> offsets{};
+  for (u32 i = 0; i < num_texgens; ++i)
+  {
+    const TexMtxInfo& info = xfmem.texMtxInfo[i];
+    const u32 row = static_cast<u32>(info.sourcerow.Value());
+    if (info.texgentype != TexGenType::Regular || info.projection != TexSize::ST ||
+        row < static_cast<u32>(SourceRow::Tex0) || row > static_cast<u32>(SourceRow::Tex7))
+    {
+      return false;
+    }
+    // Two float components only: a third one carries a per-vertex matrix index.
+    const AttributeFormat& tc = decl.texcoords[row - static_cast<u32>(SourceRow::Tex0)];
+    if (!tc.enable || tc.type != ComponentFormat::Float || tc.components != 2)
+      return false;
+    const float* m = &xfmem.posMatrices[matrix_index[i] * 4];
+    if (m[0] != 1.0f || m[1] != 0.0f || m[2] != 0.0f || m[3] != 0.0f || m[4] != 0.0f ||
+        m[5] != 1.0f || m[6] != 0.0f || m[7] != 0.0f)
+    {
+      return false;
+    }
+    // GXInit enables the dual (post) transform with an identity matrix; accept
+    // it only when it leaves s/t unchanged and does not normalize.
+    if (xfmem.dualTexTrans.enabled)
+    {
+      const PostMtxInfo& post = xfmem.postMtxInfo[i];
+      const float* pm = &xfmem.postMatrices[(post.index & 0x3f) * 4];
+      if (post.normalize || pm[0] != 1.0f || pm[1] != 0.0f || pm[2] != 0.0f || pm[3] != 0.0f ||
+          pm[4] != 0.0f || pm[5] != 1.0f || pm[6] != 0.0f || pm[7] != 0.0f)
+      {
+        return false;
+      }
+    }
+    offsets[i] = tc.offset;
+  }
+  constexpr float epsilon = 1.0f / 4096.0f;
+  for (u32 v = 0; v < num_verts; ++v)
+  {
+    const u8* vertex = m_base_buffer_pointer + static_cast<size_t>(v) * decl.stride;
+    for (u32 i = 0; i < num_texgens; ++i)
+    {
+      if (vertex + offsets[i] + 2 * sizeof(float) > m_cur_buffer_pointer)
+        return false;
+      float st[2];
+      std::memcpy(st, vertex + offsets[i], sizeof(st));
+      if (!(st[0] >= -epsilon && st[0] <= 1.0f + epsilon && st[1] >= -epsilon &&
+            st[1] <= 1.0f + epsilon))
+      {
+        return false;
+      }
+    }
+  }
+  return true;
+}
