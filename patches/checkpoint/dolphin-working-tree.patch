+void VertexShaderManager::CenterOrthographicProjection(std::array<float, 16>& matrix,
+                                                       float x, float y)
+{
+  // Include the translation terms: scaling only the diagonal shifts the HUD
+  // toward a corner instead of centering its original layout.
+  for (size_t column = 0; column < 4; ++column)
+  {
+    matrix[column] *= x;
+    matrix[4 + column] *= y;
+  }
+}
+
+bool VertexShaderManager::IsScreenComposite(const ZMode& depth, const BlendMode& blend)
+{
+  // Crazy Taxi builds its shadow alpha mask in the world pass, then modulates
+  // the completed framebuffer with a depth-disabled screen-space texture.
+  // This pass must sample the whole viewport, never the centered HUD region.
+  return !depth.test_enable && !depth.update_enable && blend.blend_enable &&
+         !blend.subtract && blend.src_factor == SrcBlendFactor::Zero &&
+         blend.dst_factor == DstBlendFactor::SrcAlpha;
+}
+
+bool VertexShaderManager::ProjectionPolicyChanged() const
+{
+  return m_last_projection_scale_x != g_ActiveConfig.fAspectRatioHackW ||
+         m_last_projection_scale_y != g_ActiveConfig.fAspectRatioHackH ||
+         m_last_center_orthographic != Config::Get(Config::GFX_CENTER_ORTHOGRAPHIC_PROJECTION) ||
+         (xfmem.projection.type == ProjectionType::Orthographic &&
+          m_last_screen_composite != IsScreenComposite(bpmem.zmode, bpmem.blendmode));
+}
